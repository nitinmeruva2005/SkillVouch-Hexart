# OpenRouter API Configuration (Free Llama 3.3 70B)
VITE_OPENROUTER_API_KEY=your-openrouter-api-key-here
LLAMA_API_KEY=your-openrouter-api-key-here

# Get your free API key from: https://openrouter.ai/settings/keys
# Free tier includes Llama 3.3 70B with generous limits

LLAMA_API_URL=https://openrouter.ai/api/v1

# Mistral AI Configuration (for quiz generation)
MISTRAL_API_KEY=your-mistral-api-key-here
# Get your API key from: https://console.mistral.ai/

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your-password
DB_NAME=skillvouch

# OpenRouter Settings
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=SkillVouch AI
